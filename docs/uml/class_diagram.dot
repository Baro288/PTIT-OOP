digraph G {
rankdir=BT; nodesep=0.45; ranksep=0.9; splines=true; fontname="Helvetica";
labelloc=t; label="Nhóm 05 – Trò chơi Rắn săn mồi: Sơ đồ lớp (rút gọn)"; fontsize=16;
node [shape=plaintext fontname="Helvetica" fontsize=10]; edge [fontname="Helvetica" fontsize=9];
GameObject [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff2cc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>GameObject</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-position: Point<BR/>-color: Color</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+draw(g, cellSize) {abstract}<BR/>+occupies(cell): boolean</TD></TR></TABLE>>];
Snake [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>Snake</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-body: LinkedList&lt;Point&gt;<BR/>-direction: Direction</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+move()<BR/>+grow(n)<BR/>+shrink(n)<BR/>+changeDirection(d)<BR/>+hasHitItself()</TD></TR></TABLE>>];
Food [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>Food</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-points: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTo(snake)<BR/>+getEatSound(): SoundEffect<BR/>+update(deltaMs)<BR/>+isExpired()<BR/>+draw(g, cellSize)</TD></TR></TABLE>>];
BonusFood [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>BonusFood</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-remainingMs: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getEatSound()<BR/>+update(deltaMs)<BR/>+isExpired()</TD></TR></TABLE>>];
PoisonFood [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«BONUS»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>PoisonFood</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-remainingMs: int</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+applyTo(snake)  (rắn ngắn lại)<BR/>+getEatSound()<BR/>+update(deltaMs)<BR/>+isExpired()</TD></TR></TABLE>>];
Player [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«BONUS»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Player</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-number: int<BR/>-snake: Snake<BR/>-score: int<BR/>-alive: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+addScore(points)<BR/>+die()</TD></TR></TABLE>>];
SoundEffect [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e1d5e7"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«enum»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>SoundEffect</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">EAT, BONUS,<BR/>POISON, GAME_OVER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getStartHz()<BR/>+getDurationMs()</TD></TR></TABLE>>];
SoundPlayer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«BONUS»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>SoundPlayer</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-enabled: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+play(effect)<BR/>+onFoodEaten(engine, food)<BR/>+onGameOver(engine)</TD></TR></TABLE>>];
Obstacle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>Obstacle</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+draw(g, cellSize)</TD></TR></TABLE>>];
Direction [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e1d5e7"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«enum»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Direction</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">UP, DOWN, LEFT, RIGHT</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+isOpposite(d)</TD></TR></TABLE>>];
GameState [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e1d5e7"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«enum»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>GameState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">READY, RUNNING,<BR/>PAUSED, GAME_OVER</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+canTransitionTo(next)</TD></TR></TABLE>>];
LevelConfig [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#d5e8d4"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>LevelConfig</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+getNumber()<BR/>+getName()<BR/>+createObstacles()</TD></TR></TABLE>>];
AbstractLevel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff2cc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>AbstractLevel</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+createObstacles() {abstract}</TD></TR></TABLE>>];
Level1 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>Level1</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+createObstacles()</TD></TR></TABLE>>];
Level2 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>Level2</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+createObstacles()</TD></TR></TABLE>>];
Level3 [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>Level3</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+createObstacles()</TD></TR></TABLE>>];
ScoreRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«immutable»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ScoreRecord</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-name, score, level, date</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+compareTo(other)</TD></TR></TABLE>>];
GameControls [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#d5e8d4"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>GameControls</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+changeDirection(player, d)<BR/>+togglePause()<BR/>+startOrRestart()</TD></TR></TABLE>>];
GameListener [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#d5e8d4"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>GameListener</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+onUpdate(engine)<BR/>+onFoodEaten(engine, food)<BR/>+onGameOver(engine)</TD></TR></TABLE>>];
GameEngine [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>GameEngine</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-timer: javax.swing.Timer<BR/>-state: GameState<BR/>-players: List&lt;Player&gt;<BR/>-twoPlayerMode: boolean</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+setLevel(level)<BR/>+setTwoPlayerMode(on)<BR/>+getWinner()<BR/>+addGameListener(l)</TD></TR></TABLE>>];
ScoreStatistics [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«immutable»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ScoreStatistics</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+of(history) {static}<BR/>+getAverageByLevel()<BR/>+getRecent(n)</TD></TR></TABLE>>];
HighScoreRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#d5e8d4"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«interface»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>HighScoreRepository</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+save(r)<BR/>+findAll()<BR/>+findTop(n)<BR/>+findRecent(n)</TD></TR></TABLE>>];
FileHighScoreRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>FileHighScoreRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+save(r)<BR/>+findAll()</TD></TR></TABLE>>];
InMemoryHighScoreRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>InMemoryHighScoreRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+save(r)<BR/>+findAll()</TD></TR></TABLE>>];
HighScoreException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#f8cecc"><TR><TD ALIGN="CENTER"><B>HighScoreException</B></TD></TR></TABLE>>];
BaseWindow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fff2cc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«abstract»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>BaseWindow</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#initUI() {abstract}<BR/>#showAbout()<BR/>#setStatus(msg)</TD></TR></TABLE>>];
MainWindow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>MainWindow</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-engine: GameEngine<BR/>-scores: HighScoreRepository</TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#initUI()<BR/>#showAbout()</TD></TR></TABLE>>];
ChartWindow [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«DISPOSE_ON_CLOSE»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ChartWindow</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+refresh()</TD></TR></TABLE>>];
GameBoardPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>GameBoardPanel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">#paintComponent(g)<BR/>+onUpdate(engine)</TD></TR></TABLE>>];
ScoreChartsPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>ScoreChartsPanel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+refresh()</TD></TR></TABLE>>];
GameOverDialog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>GameOverDialog</B></TD></TR></TABLE>>];
HighScoreDialog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>HighScoreDialog</B></TD></TR></TABLE>>];
AboutDialog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>AboutDialog</B></TD></TR></TABLE>>];
HighScoreTableModel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><B>HighScoreTableModel</B></TD></TR></TABLE>>];
ChartHelper [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#dae8fc"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«utility»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ChartHelper</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+installTheme()<BR/>+createRecentScoresChart()<BR/>+createAverageByLevelChart()</TD></TR></TABLE>>];
JFrame [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eeeeee"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«Swing»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>JFrame</B></TD></TR></TABLE>>];
JPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eeeeee"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«Swing»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>JPanel</B></TD></TR></TABLE>>];
JDialog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eeeeee"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«Swing»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>JDialog</B></TD></TR></TABLE>>];
AbstractTableModel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#eeeeee"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="9">«Swing»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>AbstractTableModel</B></TD></TR></TABLE>>];
Snake -> GameObject [arrowhead=empty];
Food -> GameObject [arrowhead=empty];
Obstacle -> GameObject [arrowhead=empty];
BonusFood -> Food [arrowhead=empty];
PoisonFood -> Food [arrowhead=empty];
SoundPlayer -> GameListener [arrowhead=empty style=dashed];
Level1 -> AbstractLevel [arrowhead=empty];
Level2 -> AbstractLevel [arrowhead=empty];
Level3 -> AbstractLevel [arrowhead=empty];
MainWindow -> BaseWindow [arrowhead=empty];
BaseWindow -> JFrame [arrowhead=empty];
ChartWindow -> JFrame [arrowhead=empty];
GameBoardPanel -> JPanel [arrowhead=empty];
ScoreChartsPanel -> JPanel [arrowhead=empty];
GameOverDialog -> JDialog [arrowhead=empty];
HighScoreDialog -> JDialog [arrowhead=empty];
AboutDialog -> JDialog [arrowhead=empty];
HighScoreTableModel -> AbstractTableModel [arrowhead=empty];
AbstractLevel -> LevelConfig [arrowhead=empty style=dashed];
GameEngine -> GameControls [arrowhead=empty style=dashed];
FileHighScoreRepository -> HighScoreRepository [arrowhead=empty style=dashed];
InMemoryHighScoreRepository -> HighScoreRepository [arrowhead=empty style=dashed];
GameBoardPanel -> GameListener [arrowhead=empty style=dashed];
MainWindow -> GameListener [arrowhead=empty style=dashed];
GameEngine -> Player [arrowhead=none arrowtail=diamond dir=back];
Player -> Snake [arrowhead=none arrowtail=diamond dir=back];
MainWindow -> SoundPlayer [arrowhead=none arrowtail=diamond dir=back];
Food -> SoundEffect [arrowhead=open style=dashed color="#666666"];
SoundPlayer -> SoundEffect [arrowhead=open style=dashed color="#666666"];
GameEngine -> Food [arrowhead=none arrowtail=diamond dir=back];
GameEngine -> Obstacle [arrowhead=none arrowtail=diamond dir=back];
GameEngine -> LevelConfig [arrowhead=none arrowtail=diamond dir=back];
MainWindow -> GameEngine [arrowhead=none arrowtail=diamond dir=back];
MainWindow -> GameBoardPanel [arrowhead=none arrowtail=diamond dir=back];
MainWindow -> ChartWindow [arrowhead=none arrowtail=diamond dir=back];
ChartWindow -> ScoreChartsPanel [arrowhead=none arrowtail=diamond dir=back];
Snake -> Direction [arrowhead=none arrowtail=diamond dir=back];
GameEngine -> GameState [arrowhead=none arrowtail=diamond dir=back];
HighScoreDialog -> HighScoreTableModel [arrowhead=none arrowtail=diamond dir=back];
MainWindow -> HighScoreRepository [arrowhead=open style=dashed color="#666666"];
ScoreChartsPanel -> ScoreStatistics [arrowhead=open style=dashed color="#666666"];
ScoreChartsPanel -> ChartHelper [arrowhead=open style=dashed color="#666666"];
ScoreStatistics -> ScoreRecord [arrowhead=open style=dashed color="#666666"];
HighScoreRepository -> ScoreRecord [arrowhead=open style=dashed color="#666666"];
HighScoreRepository -> HighScoreException [arrowhead=open style=dashed color="#666666"];
}